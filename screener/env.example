# Copy to screener/.env and fill in. See config.py for what each does.

# REQUIRED. Current India 10-year G-Sec yield, as a percent (e.g. 6.9 for 6.9%).
# No free live source is wired up (checked 2026-09-16) — look this up from
# rbi.org.in or your broker's terminal and update it every month or so.
INDIA_10Y_GSEC_YIELD_PCT=

# Value-screen thresholds — defensive-investor defaults, override deliberately.
MIN_ROCE_PCT=12
MAX_DEBT_EQUITY=1.0
MIN_DIVIDEND_CONSISTENCY=0.7
MIN_DIVIDEND_YIELD_PCT=0.0
MIN_SALES_CAGR_PCT=0.0

# RSI overlay — entry timing only, never a selection criterion (see
# ValueInvesting.md's scoped exception).
RSI_OVERSOLD=30

# Universe sizing. NSE equities have their own knob (top 200 by turnover);
# UNIVERSE_TOP_N is the shared cap for every OTHER NSE tier (ETF/REIT/InvIT/
# SGB) plus the US equity leg, each ranked by its own turnover/volume within
# that tier.
EQUITY_TOP_N=200
UNIVERSE_TOP_N=100
TURNOVER_LOOKBACK_DAYS=40
# ETF tier name filter (case-insensitive substring on the bhavcopy
# instrument name) — GOLD narrows the ~99 NSE ETFs down to gold funds only.
# Empty string reports every ETF, as before.
ETF_NAME_FILTER=GOLD
# Top N Binance USDT pairs by 24h quote volume to RSI-scan. Separate knob
# from UNIVERSE_TOP_N on purpose.
CRYPTO_TOP_N=50

# US equities (S&P 500) via Alpaca's free market-data API — optional, unset
# means this leg is silently skipped. Get a key at alpaca.markets (Sign Up ->
# API Keys; no funded brokerage account needed for market-data-only access).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Telegram delivery. If the SCREENER_* vars are unset this falls back to
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID (e.g. the trading bot's own .env
# values, if you copy them in) — set your own here to use a separate bot/chat.
SCREENER_TELEGRAM_BOT_TOKEN=
SCREENER_TELEGRAM_CHAT_ID=
