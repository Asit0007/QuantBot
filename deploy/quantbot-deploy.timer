[Unit]
Description=Check GitHub for new QuantBot commits every 5 minutes
Requires=quantbot-deploy.service

[Timer]
# 2 min after boot, then every 5 min. RandomizedDelaySec spreads the GitHub
# fetch so it never lands exactly on the 15m candle boundary the bot works on.
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=45
AccuracySec=15s
Persistent=true

[Install]
WantedBy=timers.target
