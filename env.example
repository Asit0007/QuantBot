# QuantBot — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git. It is already in .gitignore.

# ── Binance API (for live trading only) ──────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Telegram Bot (notifier.py) ───────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Message @userinfobot → copy your chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Shared data directory ────────────────────────────────────────
# Where bot_state.json, trade_log.csv, corpus_state.json are written.
# In Docker this is the mounted volume path inside the container.
DATA_DIR=/app/data

# ── Dashboard config ─────────────────────────────────────────────
DASHBOARD_PORT=8050
DASHBOARD_HOST=0.0.0.0
DASHBOARD_REFRESH_MS=15000

# ── Locked Strategy Parameters ───────────────────────────────────
# 5x is the validated winner from backtest_leverage.py (6.5yr, $100→$9,347, PF 1.60)
# Changing these invalidates backtest results.
SYMBOL=BTC/USDT
TIMEFRAME=15m
CANDLE_MINUTES=15
LEVERAGE=5
LONG_ATR_MULT=8.0
SHORT_ATR_MULT=6.0
RSI_LEN=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL_WIN=9
VOL_MULT=2.0
VOL_SMA_PERIOD=20
ATR_PERIOD=14
DIV_WINDOW=5
DIV_SHIFT=5
DIV_MEMORY=3
CB_TRIGGER=5
CB_HOURS=48
FEE_RATE=0.0005
CANDLES_NEEDED=200
WARMUP=50

# ── Oracle Cloud SSH (used by CI/CD — set as GitHub Secrets) ─────
# Do not put these in this file. Add to GitHub repo → Settings → Secrets.
# ORACLE_HOST=your.oracle.vm.ip
# ORACLE_USER=ubuntu
# ORACLE_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...
