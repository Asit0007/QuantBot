# ─── NEVER commit these ───────────────────────────────────────────────────────
.env
*.db
*.log
__pycache__/
*.pyc
.venv/
venv/
env/
*.pyo

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ─── Docker ──────────────────────────────────────────────────────────────────
*.tar

# Secrets — NEVER commit
.env
.env.*
!env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials
.oci/
.aws/
oci_api_key*
binance_keys*
telegram_token*

# Terraform — state contains plaintext credentials and resource IDs
terraform/terraform.tfvars
terraform/*.tfvars
terraform/*.auto.tfvars
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl
terraform/*.tfplan
terraform/crash.log

# nginx auth / TLS material — generated on the server, never in git
nginx/certs/
nginx/htpasswd
nginx/*.htpasswd

# Bot runtime state (local only)
bot_state.json
bot_activity.log
bot.log
corpus_state.json
trade_log.csv
rsi_alert_state.json
bot_paused.flag
notifier.log
rsi_history.json

# Backtest research scripts — local only
backtest_*.py

# Local agent / editor context
CLAUDE.md
.claude/
.cursor/
.aider*

# Stray local files that shouldn't end up in the repo
terraform/*.pdf